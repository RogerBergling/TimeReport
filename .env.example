# Copy this file to .env and adjust it. Do not commit .env.
#
# The master key is NOT stored here. Create secrets/timereport_master_key with:
#   ./scripts/generate-master-key.sh
#
# First-run setup token. Leave empty to generate one and print it once in the
# container log (docker compose logs timereport | grep "setup token").
TIMEREPORT_SETUP_TOKEN=

# Host-side bind address and port. Keep 127.0.0.1 when the TLS proxy is on the
# same host; expose it on a private interface only if your proxy is remote.
TIMEREPORT_HTTP_BIND=127.0.0.1
TIMEREPORT_HTTP_PORT=8080

# Public hostname(s) accepted by the app. Set your real domain, not *.
TIMEREPORT_ALLOWED_HOSTS=time.example.com

# Trusted reverse-proxy source CIDR as seen inside the container. Use the
# Docker bridge network by default, or the exact proxy address/network.
TIMEREPORT_TRUSTED_PROXIES=172.16.0.0/12

# Session and MFA behaviour.
TIMEREPORT_SESSION_MINUTES=30
TIMEREPORT_SESSION_ABSOLUTE_HOURS=12
TIMEREPORT_MFA_MINUTES=5

# Server time zone for new accounts' defaults. Each user can change their own.
TZ=UTC
