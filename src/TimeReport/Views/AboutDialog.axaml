<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.AboutDialog"
        x:CompileBindings="False"
        Title="{DynamicResource AboutTitle}"
        Width="620"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Padding="22">
    <StackPanel Spacing="10">
      <TextBlock Text="TimeReport" Classes="h1" />
      <TextBlock x:Name="VersionText" Classes="muted" />
      <TextBlock Text="{DynamicResource AboutDescription}"
                 Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource AboutDatabase}" Classes="h3" Margin="0,10,0,0" />
      <TextBlock x:Name="DatabaseText" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource AboutDataFolder}" Classes="h3" Margin="0,8,0,0" />
      <TextBlock x:Name="DataFolderText" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource AboutSettingsFile}" Classes="h3" Margin="0,8,0,0" />
      <TextBlock x:Name="SettingsText" TextWrapping="Wrap" />
      <TextBlock x:Name="SchemaText" Classes="muted" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
        <Button Content="{DynamicResource AboutOpenDataFolder}" Click="OnOpenDataFolderClick" />
        <Button Content="{DynamicResource ButtonClose}" Classes="accent" Click="OnCloseClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
