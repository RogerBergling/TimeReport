<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.DropboxSyncDialog"
        x:CompileBindings="False"
        Title="{DynamicResource DropboxSettingsTitle}"
        Width="720"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Border Padding="20">
    <StackPanel Spacing="10">
      <TextBlock Text="{DynamicResource DropboxSettingsTitle}" Classes="h2" />
      <TextBlock Text="{DynamicResource DropboxInstructions}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource DropboxLocalCopyInfo}" Classes="muted" TextWrapping="Wrap" />

      <TextBlock Text="{DynamicResource DropboxAppKey}" Classes="h3" Margin="0,8,0,0" />
      <TextBox x:Name="AppKeyTextBox" AutomationProperties.Name="{DynamicResource DropboxAppKey}" />

      <TextBlock Text="{DynamicResource DropboxAppSecret}" Classes="h3" Margin="0,8,0,0" />
      <TextBox x:Name="AppSecretTextBox" PasswordChar="*" AutomationProperties.Name="{DynamicResource DropboxAppSecret}" />

      <TextBlock Text="{DynamicResource DropboxRedirectUri}" Classes="h3" Margin="0,8,0,0" />
      <SelectableTextBlock Text="http://127.0.0.1:53682/dropbox-callback" Classes="muted" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <Button Content="{DynamicResource DropboxConnect}" Classes="accent" Click="OnConnectClick" />
        <Button Content="{DynamicResource DropboxDisconnect}" Click="OnDisconnectClick" />
      </StackPanel>

      <TextBlock Text="{DynamicResource DropboxRemotePath}" Classes="h3" Margin="0,8,0,0" />
      <TextBox x:Name="RemotePathTextBox" AutomationProperties.Name="{DynamicResource DropboxRemotePath}" />
      <TextBlock Text="{DynamicResource DropboxRemotePathHint}" Classes="muted" />

      <CheckBox x:Name="EncryptSyncCheckBox" Content="{DynamicResource DropboxEncryptSync}" />
      <TextBlock Text="{DynamicResource DropboxSyncPassphrase}" Classes="h3" Margin="0,4,0,0" />
      <TextBox x:Name="SyncPassphraseTextBox" PasswordChar="*"
               AutomationProperties.Name="{DynamicResource DropboxSyncPassphrase}" />
      <TextBlock Text="{DynamicResource DropboxSyncPassphraseHint}" Classes="muted" TextWrapping="Wrap" />

      <TextBlock Text="{DynamicResource DropboxProxy}" Classes="h3" Margin="0,8,0,0" />
      <TextBox x:Name="ProxyTextBox" AutomationProperties.Name="{DynamicResource DropboxProxy}" />
      <TextBlock Text="{DynamicResource DropboxProxyHint}" Classes="muted" TextWrapping="Wrap" />

      <TextBlock Text="{DynamicResource DropboxCaCertificate}" Classes="h3" Margin="0,8,0,0" />
      <TextBox x:Name="CaCertificateTextBox" AutomationProperties.Name="{DynamicResource DropboxCaCertificate}" />
      <TextBlock Text="{DynamicResource DropboxCaCertificateHint}" Classes="muted" TextWrapping="Wrap" />

      <CheckBox x:Name="AutoSyncCheckBox" Content="{DynamicResource DropboxAutoSync}" />

      <TextBlock x:Name="StatusText" Classes="muted" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />

      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,10,0,0">
        <Button Grid.Column="0" Content="{DynamicResource DropboxOpenAppConsole}" Click="OnOpenAppConsoleClick" />
        <Button Grid.Column="1" Content="{DynamicResource DropboxTestConnection}" Click="OnTestConnectionClick"
                Margin="8,0,0,0" />
        <Button Grid.Column="3" Content="{DynamicResource ButtonCancel}" Click="OnCancelClick"
                Margin="0,0,8,0" IsCancel="True" />
        <Button Grid.Column="4" Content="{DynamicResource ButtonSave}" Classes="accent" Click="OnSaveClick"
                IsDefault="True" />
      </Grid>
    </StackPanel>
  </Border>
  </ScrollViewer>
</Window>
