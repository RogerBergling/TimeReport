<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.MainWindow"
        x:CompileBindings="False"
        Title="TimeReport 2.1.0"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="File">
        <MenuItem Header="Database location…" Click="OnDatabaseLocationClick" />
        <Separator />
        <MenuItem Header="Backup database…" Click="OnBackupClick" />
        <MenuItem Header="Restore database…" Click="OnRestoreClick" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="Data">
        <MenuItem Header="Projects…" Click="OnProjectsClick" />
        <MenuItem Header="Refresh" Click="OnRefreshClick" />
      </MenuItem>
      <MenuItem Header="Help">
        <MenuItem Header="About TimeReport" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="18,12,18,6">
      <StackPanel>
        <TextBlock Text="TimeReport" Classes="h1" />
        <TextBlock Text="Local time reporting" Classes="muted" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="Projects" Click="OnProjectsClick" />
        <Button Content="Database" Click="OnDatabaseLocationClick" />
        <Button Content="Backup" Click="OnBackupClick" />
        <Button Content="Restore" Click="OnRestoreClick" />
        <Button Content="About" Click="OnAboutClick" />
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="2" x:Name="MainTabs" SelectionChanged="OnTabChanged" Margin="18,0,18,0">
      <TabItem Header="Timesheet">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Button Grid.Column="0" Content="◀" Classes="icon" Click="OnPreviousWeekClick" />
            <TextBlock Grid.Column="1" Text="{Binding WeekLabel}" Classes="h2"
                       VerticalAlignment="Center" Margin="10,0" />
            <Button Grid.Column="2" Content="▶" Classes="icon" Click="OnNextWeekClick" />
            <Button Grid.Column="3" Content="This week" Click="OnThisWeekClick" Margin="10,0,0,0" />
            <Button Grid.Column="5" Content="+ Add entry" Classes="accent" Click="OnAddEntryClick" />
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Margin="0,10,0,10">
            <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Worked" Classes="cardLabel" />
                <TextBlock Text="{Binding WeekWorkedText}" Classes="cardValue" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Lunch" Classes="cardLabel" />
                <TextBlock Text="{Binding WeekLunchText}" Classes="cardValue" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Away" Classes="cardLabel" />
                <TextBlock Text="{Binding WeekAwayText}" Classes="cardValue" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="X-Pause" Classes="cardLabel" />
                <TextBlock Text="{Binding WeekXPauseText}" Classes="cardValueAccent" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card">
              <StackPanel Spacing="2">
                <TextBlock Text="Days worked" Classes="cardLabel" />
                <TextBlock Text="{Binding WeekDaysWorkedText}" Classes="cardValue" />
              </StackPanel>
            </Border>
          </Grid>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DayCards}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Classes="h3" />
                          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,3,0,0">
                            <TextBlock Text="{Binding WorkedText}" Classes="muted" />
                            <TextBlock Text="{Binding LunchText}" Classes="muted" />
                            <TextBlock Text="{Binding AwayText}" Classes="muted" />
                            <TextBlock Text="{Binding XPauseText}" Classes="muted" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Add" Classes="accent"
                                Command="{Binding AddCommand}" VerticalAlignment="Top" />
                      </Grid>

                      <Grid ColumnDefinitions="90,*,70,70,80,60,60" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="Type" Classes="columnHeader" />
                        <TextBlock Grid.Column="1" Text="Project / reason" Classes="columnHeader" />
                        <TextBlock Grid.Column="2" Text="Start" Classes="columnHeader" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="End" Classes="columnHeader" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Duration" Classes="columnHeader" HorizontalAlignment="Center" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="90,*,70,70,80,60,60" Margin="0,2">
                              <TextBlock Grid.Column="0" Text="{Binding TypeText}" />
                              <TextBlock Grid.Column="1" Text="{Binding DetailText}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding StartText}" HorizontalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{Binding EndText}" HorizontalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding DurationText}" HorizontalAlignment="Center" />
                              <Button Grid.Column="5" Content="Edit" Classes="link"
                                      Command="{Binding EditCommand}" />
                              <Button Grid.Column="6" Content="Delete" Classes="link danger"
                                      Command="{Binding DeleteCommand}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="No entries yet" Classes="muted" IsVisible="{Binding IsEmpty}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Totals">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Period" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Totals.PeriodKinds}"
                      SelectedItem="{Binding Totals.SelectedPeriod}" Width="120" />
            <Button Content="◀" Classes="icon" Command="{Binding Totals.PreviousCommand}"
                    IsEnabled="{Binding Totals.CanNavigate}" />
            <TextBlock Text="{Binding Totals.PeriodLabel}" Classes="h2" VerticalAlignment="Center"
                       MinWidth="280" />
            <Button Content="▶" Classes="icon" Command="{Binding Totals.NextCommand}"
                    IsEnabled="{Binding Totals.CanNavigate}" />
            <Button Content="Current" Command="{Binding Totals.CurrentCommand}"
                    IsEnabled="{Binding Totals.CanNavigate}" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*" Margin="0,10,0,10">
            <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Worked" Classes="cardLabel" />
                <TextBlock Text="{Binding Totals.WorkedText}" Classes="cardValue" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Lunch" Classes="cardLabel" />
                <TextBlock Text="{Binding Totals.LunchText}" Classes="cardValue" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Away" Classes="cardLabel" />
                <TextBlock Text="{Binding Totals.AwayText}" Classes="cardValue" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="X-Pause" Classes="cardLabel" />
                <TextBlock Text="{Binding Totals.XPauseText}" Classes="cardValueAccent" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" Margin="0,0,8,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Days worked" Classes="cardLabel" />
                <TextBlock Text="{Binding Totals.DaysWorkedText}" Classes="cardValue" />
              </StackPanel>
            </Border>
            <Border Grid.Column="5" Classes="card">
              <StackPanel Spacing="2">
                <TextBlock Text="Days away" Classes="cardLabel" />
                <TextBlock Text="{Binding Totals.DaysAwayText}" Classes="cardValue" />
              </StackPanel>
            </Border>
          </Grid>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Grid ColumnDefinitions="2*,*,*,*,*,*,*" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="Period" Classes="columnHeader" />
                <TextBlock Grid.Column="1" Text="Worked" Classes="columnHeader" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Lunch" Classes="columnHeader" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Away" Classes="columnHeader" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="X-Pause" Classes="columnHeader" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="Days worked" Classes="columnHeader" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="Days away" Classes="columnHeader" HorizontalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Totals.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="2*,*,*,*,*,*,*" Margin="0,4">
                      <TextBlock Grid.Column="0" Text="{Binding Period}" />
                      <TextBlock Grid.Column="1" Text="{Binding WorkedText}" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding LunchText}" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding AwayText}" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding XPauseText}" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding DaysWorkedText}" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding DaysAwayText}" HorizontalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Padding="18,0,18,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Database:" Classes="muted" FontSize="11" />
          <TextBlock Text="{Binding DatabasePath}" Classes="muted" FontSize="11" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="All data stays on this computer"
                   Classes="muted" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</Window>
