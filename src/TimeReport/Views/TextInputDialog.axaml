<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.TextInputDialog"
        x:CompileBindings="False"
        Title="TimeReport"
        Width="440"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Border Padding="20">
    <StackPanel Spacing="12">
      <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
      <TextBox x:Name="InputTextBox" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{DynamicResource ButtonCancel}" Click="OnCancelClick" IsCancel="True" />
        <Button Content="{DynamicResource MessageOK}" Classes="accent" Click="OnOkClick" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
  </ScrollViewer>
</Window>
