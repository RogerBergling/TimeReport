<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.DatabaseLocationDialog"
        x:CompileBindings="False"
        Title="{DynamicResource DatabaseLocationTitle}"
        Width="660"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Padding="20">
    <StackPanel Spacing="10">
      <TextBlock Text="{DynamicResource DatabaseLocationTitle}" Classes="h2" />

      <TextBlock Text="{DynamicResource CurrentDatabase}" Classes="h3" Margin="0,6,0,0" />
      <TextBlock x:Name="CurrentPathText" Classes="muted" TextWrapping="Wrap" />

      <TextBlock Text="{DynamicResource NewDatabaseFile}" Classes="h3" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="PathTextBox" TextChanged="OnPathChanged" />
        <Button Grid.Column="1" Content="{DynamicResource ButtonBrowseFolder}" Click="OnBrowseClick" Margin="8,0,0,0" />
      </Grid>

      <TextBlock x:Name="StatusText" Classes="muted" TextWrapping="Wrap" />
      <CheckBox x:Name="CopyCurrentCheckBox"
                Content="{DynamicResource CopyCurrentDatabase}"
                IsChecked="True" />
      <TextBlock Text="{DynamicResource DatabaseLocationInfo}"
                 Classes="muted" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,12,0,0">
        <Button Grid.Column="0" Content="{DynamicResource ButtonUseDefault}" Click="OnUseDefaultClick" />
        <Button Grid.Column="2" Content="{DynamicResource ButtonCancel}" Click="OnCancelClick" Margin="0,0,8,0" />
        <Button Grid.Column="3" x:Name="SaveButton" Content="{DynamicResource ButtonSave}" Classes="accent"
                Click="OnSaveClick" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
