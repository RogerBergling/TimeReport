<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.EntryDialog"
        x:CompileBindings="False"
        Title="Add entry"
        Width="560"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Border Padding="20">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LabelDate}" VerticalAlignment="Center"
                 Margin="0,0,14,0" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="DateTextBox" Width="160"
               HorizontalAlignment="Left" TextChanged="OnDateChanged"
               PlaceholderText="YYYY-MM-DD"
               AutomationProperties.Name="{DynamicResource LabelDate}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LabelType}" VerticalAlignment="Center"
                 Margin="0,8,14,0" />
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <ComboBox x:Name="TypeComboBox" Width="240" SelectionChanged="OnTypeChanged"
                  AutomationProperties.Name="{DynamicResource LabelType}" />
        <Button Content="{DynamicResource ButtonManageTypes}" Classes="link"
                Click="OnManageTypesClick" />
      </StackPanel>

      <Grid Grid.Row="2" Grid.ColumnSpan="2" x:Name="ProjectRow" ColumnDefinitions="Auto,*"
            Margin="0,8,0,0">
        <TextBlock Grid.Column="0" Text="{DynamicResource LabelProject}" VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="ProjectComboBox" Width="300"
                    AutomationProperties.Name="{DynamicResource LabelProject}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{DynamicResource LabelNewProject}" Classes="link" Click="OnNewProjectClick" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="3" Grid.ColumnSpan="2" x:Name="AwayRow" ColumnDefinitions="Auto,*"
            Margin="0,8,0,0">
        <TextBlock Grid.Column="0" Text="{DynamicResource LabelAwayReason}" VerticalAlignment="Center"
                   Margin="0,0,14,0" />
        <TextBox Grid.Column="1" x:Name="AwayReasonTextBox" Width="300" HorizontalAlignment="Left"
                 AutomationProperties.Name="{DynamicResource LabelAwayReason}" />
      </Grid>

      <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LabelTime}" VerticalAlignment="Center"
                 Margin="0,10,14,0" />
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
        <TextBlock Text="{DynamicResource LabelStart}" VerticalAlignment="Center" />
        <TextBox x:Name="StartTextBox" Width="80" PlaceholderText="HH:MM"
                 AutomationProperties.Name="{DynamicResource LabelStart}" />
        <TextBlock Text="{DynamicResource LabelEnd}" VerticalAlignment="Center" Margin="8,0,0,0" />
        <TextBox x:Name="EndTextBox" Width="80" PlaceholderText="HH:MM"
                 AutomationProperties.Name="{DynamicResource LabelEnd}" />
        <TextBlock Text="{DynamicResource Label24Hour}" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="InfoText" Classes="muted"
                 TextWrapping="Wrap" Margin="0,12,0,0" />
      <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="XPauseHintText"
                 Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock Grid.Row="7" Grid.ColumnSpan="2" x:Name="ValidationText"
                 Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                 AutomationProperties.LiveSetting="Assertive" />

      <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal"
                  HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
        <Button Content="{DynamicResource ButtonCancel}" Click="OnCancelClick" IsCancel="True" />
        <Button Content="{DynamicResource ButtonSave}" Classes="accent" Click="OnSaveClick" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Border>
  </ScrollViewer>
</Window>
