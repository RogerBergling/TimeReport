<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.EntryTypeEditDialog"
        x:CompileBindings="False"
        Title="{DynamicResource NewTypeTitle}"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Padding="20">
    <StackPanel Spacing="10">
      <TextBlock Text="{DynamicResource NewTypeTitle}" Classes="h2" />
      <TextBlock Text="{DynamicResource TypeNamePrompt}" Classes="h3" Margin="0,6,0,0" />
      <TextBox x:Name="NameTextBox" />
      <TextBlock Text="{DynamicResource LabelCategory}" Classes="h3" Margin="0,6,0,0" />
      <ComboBox x:Name="CategoryComboBox" Width="220" HorizontalAlignment="Left" />
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
        <Button Content="{DynamicResource ButtonCancel}" Click="OnCancelClick" />
        <Button Content="{DynamicResource ButtonSave}" Classes="accent" Click="OnSaveClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
