<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimeReport.Views.DropboxConflictDialog"
        x:CompileBindings="False"
        Title="{DynamicResource DropboxConflictTitle}"
        Width="620"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Padding="20">
      <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource DropboxConflictTitle}" Classes="h2" />
        <TextBlock Text="{DynamicResource DropboxConflict}" Classes="muted" TextWrapping="Wrap" />

        <TextBlock Text="{DynamicResource DropboxConflictLocal}" Classes="h3" Margin="0,8,0,0" />
        <TextBlock x:Name="LocalText" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource DropboxConflictRemote}" Classes="h3" Margin="0,8,0,0" />
        <TextBlock x:Name="RemoteText" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
          <Button Content="{DynamicResource DropboxConflictCancel}" Click="OnCancelClick" IsCancel="True" />
          <Button Content="{DynamicResource DropboxConflictKeepRemote}" Click="OnRemoteClick" />
          <Button Content="{DynamicResource DropboxConflictKeepLocal}" Classes="accent" Click="OnLocalClick" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
