@page
@model TimeReport.Web.Pages.LoginModel
@{
    ViewData["Title"] = WebText.T("Sign in");
    Layout = "_AuthLayout";
    ViewData["ShowDemoFill"] = true;
}

<h1 id="auth-title">@WebText.T("Sign in")</h1>
<p class="auth-lede">@WebText.T("Use the account created for you by an administrator. Two-factor authentication is required.")</p>

<partial name="_DemoHint" />

<form method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Username">@WebText.T("Username")</label>
        <input asp-for="Username" autocomplete="username" autofocus required />
    </div>
    <div class="field">
        <label asp-for="Password">@WebText.T("Password")</label>
        <div class="inline-fields">
            <div class="field grow">
                <input asp-for="Password" type="password" autocomplete="current-password" required />
            </div>
            <button class="btn btn-sm" type="button" data-toggle-password="Password"
                    aria-pressed="false" aria-label="@WebText.T("Show password")">@WebText.T("Show")</button>
        </div>
    </div>
    <div class="field-actions">
        <span class="hint">@WebText.T("Accounts are created by an administrator.")</span>
        <button class="btn btn-primary" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-lock"></use></svg>
            @WebText.T("Sign in")
        </button>
    </div>
</form>

<div class="auth-footer">
    <span>@AppInfo.Version · @WebText.T("build") @AppInfo.BuildNumber</span>
    <a asp-page="/About">@WebText.T("About TimeReport")</a>
</div>
