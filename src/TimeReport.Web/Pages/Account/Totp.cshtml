@page
@model TimeReport.Web.Pages.Account.TotpModel
@{
    ViewData["Title"] = WebText.T("Two-factor authentication");
    ViewData["Active"] = "account";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@WebText.T("Account security")</p>
        <h1>@WebText.T("Two-factor authentication")</h1>
        <p class="page-sub">
            @WebText.T("TOTP is mandatory. Add TimeReport to an authenticator app, then enter a code to finish setup.")
        </p>
    </div>
</div>

@if (Model.AlreadyConfirmed)
{
    <div class="callout success">
        <strong>@WebText.T("Two-factor authentication is enabled.")</strong>
        @WebText.T("Your account is protected with an authenticator app.")
    </div>
    <div class="panel">
        <div class="panel-body">
            <div class="btn-row">
                <a class="btn btn-primary" asp-page="/Account/Security">@WebText.T("Security overview")</a>
                <a class="btn btn-ghost" asp-page="/Account/RecoveryCodes">@WebText.T("Recovery codes")</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="split">
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>@WebText.T("Scan the QR code")</h2>
                    <p>@WebText.T("Use Google Authenticator, Microsoft Authenticator, 1Password, Bitwarden or any TOTP app.")</p>
                </div>
            </div>
            <div class="panel-body">
                <div class="qr-wrap">
                    <div class="qr-code">
                        <img src="@Model.QrDataUrl" alt="@WebText.T("QR code for the TimeReport demo guest")" width="190" height="190" />
                    </div>
                    <div>
                        <p class="muted">@WebText.T("Can't scan it? Enter this secret manually:")</p>
                        <span class="secret-code" id="totp-secret">@Model.SecretDisplay</span>
                        <div class="btn-row mt-1">
                            <button class="btn btn-sm" type="button" data-copy-target="totp-secret">@WebText.T("Copy secret")</button>
                        </div>
                    </div>
                </div>

                <hr class="divider" />

                <form method="post">
                    <div class="field">
                        <label asp-for="CurrentPassword">@WebText.T("Current password")</label>
                        <div class="inline-fields">
                            <div class="field grow">
                                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
                            </div>
                            <button class="btn btn-sm" type="button" data-toggle-password="CurrentPassword"
                                    aria-pressed="false" aria-label="@WebText.T("Show password")">@WebText.T("Show")</button>
                        </div>
                        <p class="hint">@WebText.T("Re-authentication is required to enable TOTP.")</p>
                    </div>
                    <div class="field">
                        <label asp-for="Code">@WebText.T("Enter the 6-digit code")</label>
                        <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code"
                               pattern="[0-9]{6}" maxlength="6" placeholder="000000"
                               class="mono" required />
                        <p class="hint">@WebText.T("The code changes every 30 seconds. Make sure the device clock is correct.")</p>
                    </div>
                    <div class="field-actions">
                        <span class="hint">@WebText.T("Recovery codes are generated after verification.")</span>
                        <button class="btn btn-primary" type="submit">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-shield"></use></svg>
                            @WebText.T("Enable TOTP")
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>@WebText.T("Why this is required")</h2>
                    <p>@WebText.T("Your time data is private; a password alone is not enough.")</p>
                </div>
            </div>
            <div class="panel-body">
                <ul class="security-list">
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("Every account must confirm TOTP before opening timesheets.")</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("Recovery codes are single-use and stored only as keyed hashes.")</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("An administrator must reset MFA if your authenticator is lost.")</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("Keep a copy of your recovery codes somewhere offline.")</span></li>
                </ul>
            </div>
        </section>
    </div>
}
