@page "/account/recovery-codes"
@model TimeReport.Web.Pages.Account.RecoveryCodesModel
@{
    ViewData["Title"] = WebText.T("Recovery codes");
    ViewData["Active"] = "account";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@WebText.T("Account security")</p>
        <h1>@WebText.T("Recovery codes")</h1>
        <p class="page-sub">
            @WebText.T("Recovery codes let you sign in when your authenticator app is unavailable. Each code works once.")
        </p>
    </div>
</div>

@if (Model.Required)
{
    <div class="callout warn">
        <strong>@WebText.T("Recovery codes are required.")</strong>
        @WebText.T("Generate a set before using the application. If you lose your authenticator and have no codes, an administrator must reset your MFA.")
    </div>
}

@if (Model.NewCodes is not null)
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>@WebText.T("Save these codes now")</h2>
                <p>@WebText.T("They are not shown again. Store them offline, not in the same place as your password.")</p>
            </div>
            <span class="pill warn">@WebText.T("Shown once")</span>
        </div>
        <div class="panel-body">
            <div class="recovery-grid">
                @foreach (var code in Model.NewCodes)
                {
                    <span class="recovery-code">@code</span>
                }
            </div>
            <div class="btn-row">
                <button class="btn btn-primary" type="button" data-print>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-download"></use></svg>
                    @WebText.T("Print / save as PDF")
                </button>
                <a class="btn btn-ghost" asp-page="/Account/Security">@WebText.T("I saved them")</a>
            </div>
            <p class="hint mt-1">@WebText.T("Printing uses your browser's print dialog. Choose \"Save as PDF\" to keep a copy.")</p>
        </div>
    </section>
}
else if (Demo.IsGuest(Model.CurrentUser))
{
    <div class="callout warn">
        <strong>@WebText.T("Demo guest recovery codes are fixed.")</strong>
        @WebText.T("Use {0} on the sign-in page. Create another user to test credential changes and recovery-code regeneration.", Demo.GuestRecoveryCode)
    </div>
}
else
{
    <div class="split">
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>@WebText.T("Generate a new set")</h2>
                    <p>@WebText.T("Generating a new set invalidates every unused code from the previous set.")</p>
                </div>
                <span class="pill @(Model.Remaining > 0 ? "ok" : "warn")">@Model.Remaining @WebText.T("remaining")</span>
            </div>
            <div class="panel-body">
                <form method="post" novalidate>
                    <div class="field">
                        <label asp-for="CurrentPassword">@WebText.T("Current password")</label>
                        <div class="inline-fields">
                            <div class="field grow">
                                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                            </div>
                            <button class="btn btn-sm" type="button" data-toggle-password="CurrentPassword"
                                    aria-pressed="false" aria-label="@WebText.T("Show password")">@WebText.T("Show")</button>
                        </div>
                        <p class="hint">@WebText.T("Re-authentication is required to replace recovery codes.")</p>
                    </div>
                    <div class="field-actions">
                        <span class="hint">@WebText.T("Ten codes are generated each time.")</span>
                        <button class="btn btn-primary" type="submit">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-key"></use></svg>
                            @WebText.T("Generate codes")
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>@WebText.T("How recovery codes work")</h2>
                    <p>@WebText.T("Useful when your phone is lost, replaced or wiped.")</p>
                </div>
            </div>
            <div class="panel-body">
                <ul class="security-list">
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("Each code can be used exactly once.")</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("Codes are stored as keyed hashes, never as plaintext.")</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("When you use a code, it is marked used immediately.")</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>@WebText.T("Generating replacements removes all old unused codes.")</span></li>
                </ul>
            </div>
        </section>
    </div>
}
