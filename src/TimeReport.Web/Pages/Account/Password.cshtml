@page
@model TimeReport.Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Active"] = "account";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Account</p>
        <h1>@(Model.Forced ? "Choose a new password" : "Change password")</h1>
        <p class="page-sub">
            @if (Model.Forced)
            {
                <span>You are using a temporary password. Choose your own password before continuing.</span>
            }
            else
            {
                <span>Changing your password signs out other browser sessions.</span>
            }
        </p>
    </div>
</div>

<div class="split">
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>Password</h2>
                <p>Use at least 12 characters. A long passphrase is best.</p>
            </div>
        </div>
        <div class="panel-body">
            @if (Demo.IsGuest(Model.CurrentUser))
            {
                <div class="callout warn">
                    <strong>Demo guest credentials are fixed.</strong>
                    Create another user under <a asp-page="/Admin/Users">Users</a> to test password changes.
                </div>
            }
            else
            {
            <form method="post" novalidate>
                <div class="field">
                    <label asp-for="CurrentPassword">Current password</label>
                    <div class="inline-fields">
                        <div class="field grow">
                            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
                        </div>
                        <button class="btn btn-sm" type="button" data-toggle-password="CurrentPassword"
                                aria-pressed="false" aria-label="Show password">Show</button>
                    </div>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="NewPassword">New password</label>
                        <div class="inline-fields">
                            <div class="field grow">
                                <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
                            </div>
                            <button class="btn btn-sm" type="button" data-toggle-password="NewPassword"
                                    aria-pressed="false" aria-label="Show password">Show</button>
                        </div>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword">Confirm new password</label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
                    </div>
                </div>
                <div class="field-actions">
                    @if (!Model.Forced)
                    {
                        <a class="btn btn-ghost" asp-page="/Account/Totp">Cancel</a>
                    }
                    <button class="btn btn-primary" type="submit">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-lock"></use></svg>
                        Save password
                    </button>
                </div>
            </form>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>Good to know</h2>
                <p>Security details for your account.</p>
            </div>
        </div>
        <div class="panel-body">
            <ul class="security-list">
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>Current-password re-authentication is required.</span></li>
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>Other sessions are revoked when the password changes.</span></li>
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-check"></use></svg><span>Administrators can reset a password, but they never see it.</span></li>
            </ul>
        </div>
    </section>
</div>
