@page
@model TimeReport.Web.Pages.Account.SecurityModel
@{
    ViewData["Title"] = WebText.T("Security");
    ViewData["Active"] = "account";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@WebText.T("Account")</p>
        <h1>@WebText.T("Security")</h1>
        <p class="page-sub">@WebText.T("Your sign-in, MFA and recovery settings.")</p>
    </div>
    <a class="btn btn-ghost" asp-page="/Account/Settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-settings"></use></svg>
        @WebText.T("Settings")
    </a>
</div>

@if (Demo.IsGuest(Model.CurrentUser))
{
    <div class="callout warn">
        <strong>@WebText.T("Demo guest.")</strong>
        @WebText.T("The guest has administrator access with fixed credentials. Create another user to test password, MFA and recovery-code changes. Everything resets every {0} hour(s).", Demo.ResetHours)
    </div>
}

<div class="cards">
    <div class="stat-card">
        <span class="stat-label">@WebText.T("Account")</span>
        <span class="stat-value">@Model.CurrentUser.Username</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@WebText.T("Role")</span>
        <span class="stat-value">@WebText.T(Model.CurrentUser.IsAdmin ? "Administrator" : "User")</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@WebText.T("TOTP")</span>
        <span class="stat-value ok">
            @WebText.T(Model.CurrentUser.TotpConfirmed ? "Enabled" : "Setup required")
        </span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@WebText.T("Recovery codes")</span>
        <span class="stat-value @(Model.CurrentUser.UnusedRecoveryCodes > 0 ? "ok" : "violet")">
            @Model.CurrentUser.UnusedRecoveryCodes
        </span>
    </div>
</div>

<div class="split">
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>@WebText.T("Account protection")</h2>
                <p>@WebText.T("All changes require your current password.")</p>
            </div>
        </div>
        <div class="panel-body">
            <div class="stack-sm">
                <div class="btn-row">
                    <a class="btn btn-primary" asp-page="/Account/Password">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-lock"></use></svg>
                        @WebText.T("Change password")
                    </a>
                    <a class="btn" asp-page="/Account/RecoveryCodes">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-key"></use></svg>
                        @WebText.T("Manage recovery codes")
                    </a>
                    <a class="btn btn-ghost" asp-page="/Account/Totp">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-qr"></use></svg>
                        @WebText.T("Authenticator status")
                    </a>
                </div>
                <p class="hint mt-1">
                    @WebText.T("TOTP cannot be disabled from the application. If you lose your authenticator, use a recovery code or ask an administrator to reset MFA.")
                </p>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>@WebText.T("Recent security events")</h2>
                <p>@WebText.T("Sign-ins and account changes for this account.")</p>
            </div>
        </div>
        <div class="panel-body tight">
            @if (Model.Events.Count == 0)
            {
                <p class="muted">@WebText.T("No events recorded yet.")</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>@WebText.T("Time (UTC)")</th>
                                <th>@WebText.T("Action")</th>
                                <th>@WebText.T("Detail")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Events)
                            {
                                <tr>
                                    <td class="mono">@entry.AtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@entry.Action</td>
                                    <td class="muted">@entry.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
