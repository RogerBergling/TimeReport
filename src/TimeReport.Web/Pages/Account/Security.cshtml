@page
@model TimeReport.Web.Pages.Account.SecurityModel
@{
    ViewData["Title"] = "Security";
    ViewData["Active"] = "account";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Account</p>
        <h1>Security</h1>
        <p class="page-sub">Your sign-in, MFA and recovery settings.</p>
    </div>
    <a class="btn btn-ghost" asp-page="/Account/Settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-settings"></use></svg>
        Settings
    </a>
</div>

@if (Demo.IsGuest(Model.CurrentUser))
{
    <div class="callout warn">
        <strong>Demo guest.</strong>
        The guest has administrator access with fixed credentials. Create another user
        to test password, MFA and recovery-code changes. Everything resets every
        @Demo.ResetHours hour(s).
    </div>
}

<div class="cards">
    <div class="stat-card">
        <span class="stat-label">Account</span>
        <span class="stat-value">@Model.CurrentUser.Username</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Role</span>
        <span class="stat-value">@(Model.CurrentUser.IsAdmin ? "Administrator" : "User")</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">TOTP</span>
        <span class="stat-value ok">
            @(Model.CurrentUser.TotpConfirmed ? "Enabled" : "Setup required")
        </span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Recovery codes</span>
        <span class="stat-value @(Model.CurrentUser.UnusedRecoveryCodes > 0 ? "ok" : "violet")">
            @Model.CurrentUser.UnusedRecoveryCodes
        </span>
    </div>
</div>

<div class="split">
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>Account protection</h2>
                <p>All changes require your current password.</p>
            </div>
        </div>
        <div class="panel-body">
            <div class="stack-sm">
                <div class="btn-row">
                    <a class="btn btn-primary" asp-page="/Account/Password">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-lock"></use></svg>
                        Change password
                    </a>
                    <a class="btn" asp-page="/Account/RecoveryCodes">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-key"></use></svg>
                        Manage recovery codes
                    </a>
                    <a class="btn btn-ghost" asp-page="/Account/Totp">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-qr"></use></svg>
                        Authenticator status
                    </a>
                </div>
                <p class="hint mt-1">
                    TOTP cannot be disabled from the application. If you lose your authenticator,
                    use a recovery code or ask an administrator to reset MFA.
                </p>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>Recent security events</h2>
                <p>Sign-ins and account changes for this account.</p>
            </div>
        </div>
        <div class="panel-body tight">
            @if (Model.Events.Count == 0)
            {
                <p class="muted">No events recorded yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Time (UTC)</th>
                                <th>Action</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Events)
                            {
                                <tr>
                                    <td class="mono">@entry.AtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@entry.Action</td>
                                    <td class="muted">@entry.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
