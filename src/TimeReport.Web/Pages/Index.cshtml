@page
@model TimeReport.Web.Pages.IndexModel
@{
    ViewData["Title"] = WebText.T("Timesheet");
    ViewData["Active"] = "timesheet";
    var week = Model.Week;
}

<div class="page-head">
    <div>
        <p class="eyebrow">@WebText.T("Timesheet")</p>
        <h1>@WebText.T("Your week")</h1>
        <p class="page-sub">@WebText.T("Work, lunch, away and X-Pause for the selected Monday–Sunday week. Week starts Monday; times use the 24-hour clock.")</p>
    </div>
    <a class="btn btn-primary" asp-page="/Entries/Edit" asp-route-date="@(week.Start.ToString("yyyy-MM-dd"))">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-plus"></use></svg>
        @WebText.T("Add entry")
    </a>
</div>

<div class="week-toolbar">
    <a class="btn btn-icon" asp-page="/Index" asp-route-week="@(week.Start.AddDays(-7).ToString("yyyy-MM-dd"))"
       aria-label="@WebText.T("Previous week")" title="@WebText.T("Previous week")">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
    </a>
    <span class="week-label">@week.Label</span>
    <a class="btn btn-icon" asp-page="/Index" asp-route-week="@(week.Start.AddDays(7).ToString("yyyy-MM-dd"))"
       aria-label="@WebText.T("Next week")" title="@WebText.T("Next week")">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
    </a>
    <a class="btn btn-sm" asp-page="/Index">@WebText.T("This week")</a>
    <a class="btn btn-sm btn-ghost" asp-page="/Totals" asp-route-period="week" asp-route-anchor="@(week.Start.ToString("yyyy-MM-dd"))">
        @WebText.T("Open totals")
    </a>
</div>

<div class="cards">
    <div class="stat-card">
        <span class="stat-label">@LocalizationService.T("LabelWorked")</span>
        <span class="stat-value">@week.WorkedText</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@LocalizationService.T("LabelLunch")</span>
        <span class="stat-value">@week.LunchText</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@LocalizationService.T("LabelAway")</span>
        <span class="stat-value">@week.AwayText</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@LocalizationService.T("LabelXPause")</span>
        <span class="stat-value violet">@week.XPauseText</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@LocalizationService.T("LabelOvertime")</span>
        <span class="stat-value accent">@week.OvertimeText</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">@LocalizationService.T("LabelDaysWorked")</span>
        <span class="stat-value">@week.DaysWorkedText</span>
    </div>
</div>

@foreach (var day in week.Days)
{
    <section class="day-card @(day.IsToday ? "today" : null)">
        <div class="day-head">
            <div class="day-title">
                @day.Title
                @if (day.IsToday)
                {
                    <span class="today-mark">@WebText.T("Today")</span>
                }
            </div>
            <div class="day-totals">
                <span>@LocalizationService.T("LabelWorked") <strong>@day.WorkedText</strong></span>
                <span>@LocalizationService.T("LabelLunch") <strong>@day.LunchText</strong></span>
                <span>@LocalizationService.T("LabelAway") <strong>@day.AwayText</strong></span>
                <span>@LocalizationService.T("LabelXPause") <strong>@day.XPauseText</strong></span>
                <span>@LocalizationService.T("LabelOvertime") <strong>@day.OvertimeText</strong></span>
            </div>
            <a class="btn btn-sm btn-ghost" asp-page="/Entries/Edit" asp-route-date="@day.Date.ToString("yyyy-MM-dd")">
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-plus"></use></svg>
                @WebText.T("Add")
            </a>
        </div>

        @if (day.Entries.Count == 0)
        {
            <p class="empty-row">@WebText.T("No entries yet.")</p>
        }
        else
        {
            <div class="table-wrap table-flush">
                <table class="entry-table">
                    <thead>
                        <tr>
                            <th>@WebText.T("Type")</th>
                            <th>@WebText.T("Project / reason")</th>
                            <th>@WebText.T("Start")</th>
                            <th>@WebText.T("End")</th>
                            <th>@WebText.T("Duration")</th>
                            <th class="actions-col">@WebText.T("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in day.Entries)
                        {
                            <tr>
                                <td>
                                    <span class="entry-type @entry.TypeClass">
                                        <span class="dot" aria-hidden="true"></span>
                                        @entry.TypeText
                                    </span>
                                </td>
                                <td class="detail">@entry.DetailText</td>
                                <td class="entry-time">@entry.StartText</td>
                                <td class="entry-time">@entry.EndText</td>
                                <td class="entry-duration">@entry.DurationText</td>
                                <td>
                                    <div class="table-actions">
                                        <a class="btn btn-icon" asp-page="/Entries/Edit" asp-route-id="@entry.Id"
                                           aria-label="@WebText.T("Edit") @entry.TypeText" title="@WebText.T("Edit")">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-edit"></use></svg>
                                        </a>
                                        <form method="post" asp-page="/Index" asp-page-handler="Delete"
                                              data-confirm="@WebText.T("Delete this entry?")">
                                            <input type="hidden" name="id" value="@entry.Id" />
                                            <input type="hidden" name="week" value="@(week.Start.ToString("yyyy-MM-dd"))" />
                                            <button class="btn btn-icon" type="submit"
                                                    aria-label="@WebText.T("Delete") @entry.TypeText" title="@WebText.T("Delete")">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-trash"></use></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
