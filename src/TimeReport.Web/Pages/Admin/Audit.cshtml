@page
@model TimeReport.Web.Pages.Admin.AuditModel
@{
    ViewData["Title"] = WebText.T("Audit log");
    ViewData["Active"] = "admin";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@WebText.T("Administration")</p>
        <h1>@WebText.T("Audit log")</h1>
        <p class="page-sub">@WebText.T("Authentication and account-management events. Passwords, codes and secrets are never logged.")</p>
    </div>
    <a class="btn btn-ghost" asp-page="/Admin/Users">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-users"></use></svg>
        @WebText.T("Users")
    </a>
</div>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>@WebText.T("Recent events")</h2>
            <p>@WebText.T("Newest first. The database keeps the latest 10,000 events.")</p>
        </div>
        <span class="pill">@WebText.T("{0} shown", Model.Entries.Count)</span>
    </div>
    <div class="panel-body tight">
        @if (Model.Entries.Count == 0)
        {
            <p class="muted">@WebText.T("No events recorded yet.")</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>@WebText.T("Time (UTC)")</th>
                            <th>@WebText.T("Actor")</th>
                            <th>@WebText.T("Action")</th>
                            <th>@WebText.T("Detail")</th>
                            <th>@WebText.T("IP")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td class="mono nowrap">@entry.AtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(entry.Actor ?? "—")</td>
                                <td><span class="tag">@entry.Action</span></td>
                                <td class="muted">@entry.Detail</td>
                                <td class="mono">@entry.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
