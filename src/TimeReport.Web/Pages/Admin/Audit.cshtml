@page
@model TimeReport.Web.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Audit log";
    ViewData["Active"] = "admin";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Administration</p>
        <h1>Audit log</h1>
        <p class="page-sub">Authentication and account-management events. Passwords, codes and secrets are never logged.</p>
    </div>
    <a class="btn btn-ghost" asp-page="/Admin/Users">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-users"></use></svg>
        Users
    </a>
</div>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>Recent events</h2>
            <p>Newest first. The database keeps the latest 10,000 events.</p>
        </div>
        <span class="pill">@Model.Entries.Count shown</span>
    </div>
    <div class="panel-body tight">
        @if (Model.Entries.Count == 0)
        {
            <p class="muted">No events recorded yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Time (UTC)</th>
                            <th>Actor</th>
                            <th>Action</th>
                            <th>Detail</th>
                            <th>IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td class="mono nowrap">@entry.AtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(entry.Actor ?? "—")</td>
                                <td><span class="tag">@entry.Action</span></td>
                                <td class="muted">@entry.Detail</td>
                                <td class="mono">@entry.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
