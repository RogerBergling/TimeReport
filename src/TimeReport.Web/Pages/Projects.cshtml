@page
@model TimeReport.Web.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects";
    ViewData["Active"] = "projects";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Data</p>
        <h1>Projects</h1>
        <p class="page-sub">Work entries need a project. Archive projects instead of deleting ones that already have entries.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Entries/Edit">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-plus"></use></svg>
        Add entry
    </a>
</div>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>Create project</h2>
            <p>Names are unique for your account, up to 80 characters.</p>
        </div>
    </div>
    <div class="panel-body">
        <form method="post" asp-page-handler="Create" class="inline-fields">
            <div class="field grow">
                <label for="new-project-name">Project name</label>
                <input id="new-project-name" name="name" maxlength="80" required placeholder="e.g. Internal tools" />
            </div>
            <button class="btn btn-primary" type="submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-plus"></use></svg>
                Create
            </button>
        </form>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>All projects</h2>
            <p>@Model.Projects.Count project(s)</p>
        </div>
    </div>
    <div class="panel-body tight">
        @if (Model.Projects.Count == 0)
        {
            <div class="empty-state">
                <h3>No projects yet</h3>
                <p>Create a project above before adding a work entry.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Status</th>
                            <th class="num">Entries</th>
                            <th>Rename</th>
                            <th class="actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Projects)
                        {
                            <tr>
                                <td>@row.Project.Name</td>
                                <td>
                                    <span class="pill @(row.Project.Archived ? "warn" : "ok")">
                                        @(row.Project.Archived ? "Archived" : "Active")
                                    </span>
                                </td>
                                <td class="num">@row.EntryCount</td>
                                <td>
                                    <form method="post" asp-page-handler="Rename" class="inline-fields">
                                        <input type="hidden" name="id" value="@row.Project.Id" />
                                        <input name="name" value="@row.Project.Name" maxlength="80"
                                               aria-label="New name for @row.Project.Name" />
                                        <button class="btn btn-sm" type="submit">Save</button>
                                    </form>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <form method="post" asp-page-handler="Archive">
                                            <input type="hidden" name="id" value="@row.Project.Id" />
                                            <input type="hidden" name="archived" value="@((!row.Project.Archived).ToString().ToLowerInvariant())" />
                                            <button class="btn btn-sm" type="submit">
                                                @(row.Project.Archived ? "Restore" : "Archive")
                                            </button>
                                        </form>
                                        @if (row.EntryCount == 0)
                                        {
                                            <form method="post" asp-page-handler="Delete"
                                                  data-confirm="Delete this project?">
                                                <input type="hidden" name="id" value="@row.Project.Id" />
                                                <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
