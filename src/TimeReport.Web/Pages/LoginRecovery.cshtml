@page "/login/recovery"
@model TimeReport.Web.Pages.LoginRecoveryModel
@{
    ViewData["Title"] = WebText.T("Recovery code");
    Layout = "_AuthLayout";
}

@if (Model.PendingUser is not null)
{
    <h1 id="auth-title">@WebText.T("Use a recovery code")</h1>
    <p class="auth-lede">
        @WebText.T("Enter one of the single-use recovery codes you saved when you enabled two-factor authentication.")
    </p>

    <partial name="_DemoHint" />

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Code">@WebText.T("Recovery code")</label>
            <input asp-for="Code" autocomplete="off" autofocus required
                   placeholder="XXXX-XXXX-XXXX" class="mono" />
            <p class="hint">@WebText.T("Each code can be used once. Regenerate unused codes in Security after signing in.")</p>
        </div>
        <div class="field-actions">
            <a asp-page="/LoginMfa">@WebText.T("Use an authenticator code")</a>
            <button class="btn btn-primary" type="submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-key"></use></svg>
                @WebText.T("Verify")
            </button>
        </div>
    </form>

    <div class="auth-footer">
        <span>@WebText.T("Recovery codes are hashed at rest.")</span>
        <a asp-page="/Login">@WebText.T("Back to sign in")</a>
    </div>
}
else
{
    <h1 id="auth-title">@WebText.T("Verification expired")</h1>
    <p class="auth-lede">@WebText.T("Start again from the sign-in page.")</p>
    <a class="btn btn-primary" asp-page="/Login">@WebText.T("Back to sign in")</a>
}
