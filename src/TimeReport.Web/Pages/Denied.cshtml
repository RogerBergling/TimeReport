@page
@model TimeReport.Web.Pages.DeniedModel
@{
    ViewData["Title"] = WebText.T("Access denied");
}

<div class="page-head">
    <div>
        <p class="eyebrow">403</p>
        <h1>@WebText.T("Access denied")</h1>
        <p class="page-sub">@WebText.T("Your account does not have permission to open that page.")</p>
    </div>
</div>

<div class="panel">
    <div class="panel-body">
        <p class="muted">@WebText.T("Administrator pages are limited to administrator accounts. If you need access, ask an administrator to change your role.")</p>
        <div class="btn-row">
            <a class="btn btn-primary" asp-page="/Index">@WebText.T("Go to timesheet")</a>
            <a class="btn btn-ghost" asp-page="/Account/Security">@WebText.T("Security settings")</a>
        </div>
    </div>
</div>
