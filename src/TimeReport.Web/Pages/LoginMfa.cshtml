@page "/login/mfa"
@model TimeReport.Web.Pages.LoginMfaModel
@{
    ViewData["Title"] = "Two-factor verification";
    Layout = "_AuthLayout";
}

@if (Model.PendingUser is not null)
{
    <h1 id="auth-title">Verify it's you</h1>
    <p class="auth-lede">
        Enter the 6-digit code from your authenticator app for
        <strong>@Model.PendingUser.Username</strong>.
    </p>

    <partial name="_DemoHint" />

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Code">Authenticator code</label>
            <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code"
                   pattern="[0-9]{6}" maxlength="6" autofocus required
                   placeholder="000000" class="mono" />
        </div>
        <div class="field-actions">
            <a asp-page="/LoginRecovery">Use a recovery code</a>
            <button class="btn btn-primary" type="submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-shield"></use></svg>
                Verify
            </button>
        </div>
    </form>

    <div class="auth-footer">
        <span>Codes change every 30 seconds.</span>
        <a asp-page="/Login">Back to sign in</a>
    </div>
}
else
{
    <h1 id="auth-title">Verification expired</h1>
    <p class="auth-lede">Start again from the sign-in page.</p>
    <a class="btn btn-primary" asp-page="/Login">Back to sign in</a>
}
