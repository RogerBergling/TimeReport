@{
    var currentUser = Context.GetAuthUser();
    var pageModel = Model as AppPageModel;
    var active = ViewData["Active"] as string ?? string.Empty;
    var theme = currentUser?.Theme == "light" ? "light" : "dark";
    var title = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(title)
        ? "TimeReport"
        : $"{title} · TimeReport";
}
<!doctype html>
<html lang="@LocalizationService.CurrentLanguage" data-theme="@theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark light">
    <meta name="theme-color" content="#070b14">
    <title>@fullTitle</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
</head>
<body>
<a class="skip-link" href="#main">@WebText.T("Skip to content")</a>
<canvas id="matrix" aria-hidden="true"></canvas>
<div class="scanlines" aria-hidden="true"></div>
<partial name="_Icons" />

@if (Demo.Enabled)
{
    <div class="demo-ribbon" role="status">
        <span class="pill warn">@WebText.T("Demo")</span>
        @WebText.T("Fake data only · resets every {0} hour(s) · guest/guest + TOTP", Demo.ResetHours)
    </div>
}

<header class="topbar">
    <a class="brand" asp-page="/Index" aria-label="@WebText.T("TimeReport home")">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"><use href="#icon-clock"></use></svg>
        </span>
        <span class="brand-text">
            <strong>TimeReport</strong>
            <span>@WebText.T("Time, without the busywork")</span>
        </span>
    </a>

    @if (currentUser is not null)
    {
        <nav class="nav" aria-label="@WebText.T("Main")">
            <a asp-page="/Index" class="@(active == "timesheet" ? "active" : null)">@WebText.T("Timesheet")</a>
            <a asp-page="/Totals" class="@(active == "totals" ? "active" : null)">@WebText.T("Totals")</a>
            <a asp-page="/Projects" class="@(active == "projects" ? "active" : null)">@WebText.T("Projects")</a>
            <a asp-page="/Types" class="@(active == "types" ? "active" : null)">@WebText.T("Types")</a>
            <a asp-page="/Export" class="@(active == "export" ? "active" : null)">@WebText.T("Export")</a>
            @if (currentUser.IsAdmin)
            {
                <a asp-page="/Admin/Users" class="@(active == "admin" ? "active" : null)">@WebText.T("Users")</a>
            }
        </nav>
    }

    <div class="topbar-tools">
        <button class="tool-btn theme-toggle" id="theme-toggle" type="button"
                title="@WebText.T("Switch theme")" aria-label="@WebText.T("Switch theme")">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-sun"></use></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-moon"></use></svg>
            <span class="tool-label">@WebText.T("Theme")</span>
        </button>
        <button class="tool-btn" id="matrix-toggle" type="button"
                title="@WebText.T("Toggle matrix background")" aria-label="@WebText.T("Toggle matrix background")" aria-pressed="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-matrix"></use></svg>
            <span class="tool-label">@WebText.T("Matrix")</span>
        </button>
        @if (currentUser is not null)
        {
            <span class="user-chip" title="@currentUser.DisplayName">
                <span class="avatar" aria-hidden="true">@(currentUser.DisplayName.Length > 0 ? currentUser.DisplayName[..1].ToUpperInvariant() : "?")</span>
                <span class="user-name">@currentUser.DisplayName</span>
            </span>
            <a class="tool-btn" asp-page="/Account/Settings" title="@WebText.T("Settings")" aria-label="@WebText.T("Settings")">
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-settings"></use></svg>
            </a>
            <form method="post" asp-page="/Logout" class="inline-form">
                <button class="tool-btn" type="submit" title="@WebText.T("Sign out")" aria-label="@WebText.T("Sign out")">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-logout"></use></svg>
                </button>
            </form>
            <button class="tool-btn menu-toggle" id="menu-toggle" type="button"
                    aria-expanded="false" aria-controls="mobile-nav" aria-label="@WebText.T("Open menu")">
                <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-menu"></use></svg>
                <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-close"></use></svg>
            </button>
        }
    </div>

    @if (currentUser is not null)
    {
        <nav class="mobile-nav" id="mobile-nav" aria-label="@WebText.T("Mobile")" hidden>
            <a asp-page="/Index">@WebText.T("Timesheet")</a>
            <a asp-page="/Totals">@WebText.T("Totals")</a>
            <a asp-page="/Projects">@WebText.T("Projects")</a>
            <a asp-page="/Types">@WebText.T("Types")</a>
            <a asp-page="/Export">@WebText.T("Export")</a>
            @if (currentUser.IsAdmin)
            {
                <a asp-page="/Admin/Users">@WebText.T("Users")</a>
                <a asp-page="/Admin/Audit">@WebText.T("Audit")</a>
            }
            <a asp-page="/Account/Settings">@WebText.T("Settings")</a>
            <a asp-page="/Account/Security">@WebText.T("Security")</a>
        </nav>
    }
</header>

<main id="main" class="view">
    @if (!string.IsNullOrWhiteSpace(pageModel?.StatusMessage))
    {
        <div class="callout success" role="status">@pageModel.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(pageModel?.ErrorMessage))
    {
        <div class="callout danger" role="alert">@pageModel.ErrorMessage</div>
    }
    @RenderBody()
</main>

<footer class="footer">
    <div class="footer-main">
        <div class="footer-brand">
            <strong>TimeReport</strong>
            <p>@WebText.T("Private time reporting. Every account has its own encrypted database. No telemetry, no third-party requests.")</p>
        </div>
        <div class="footer-links">
            <a asp-page="/About">@WebText.T("About")</a>
            <a asp-page="/Account/Security">@WebText.T("Security")</a>
            <a href="https://github.com/RogerBergling/TimeReport" target="_blank" rel="noopener noreferrer">@WebText.T("Source")</a>
            <a href="https://github.com/RogerBergling/TimeReport/security/advisories/new" target="_blank" rel="noopener noreferrer">@WebText.T("Report a vulnerability")</a>
        </div>
    </div>
    <p class="build-stamp">
        @WebText.T("Version") @AppInfo.Version · @WebText.T("build") @AppInfo.BuildNumber
        @if (!string.IsNullOrWhiteSpace(AppInfo.BuildCommit))
        {
            <span> · @WebText.T("commit") @AppInfo.BuildCommit[..Math.Min(12, AppInfo.BuildCommit.Length)]</span>
        }
    </p>
</footer>

<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
