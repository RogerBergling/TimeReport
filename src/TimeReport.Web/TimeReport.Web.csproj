<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Version>2.6.1</Version>
    <AssemblyVersion>2.6.1.0</AssemblyVersion>
    <FileVersion>2.6.1.0</FileVersion>
    <BuildNumber Condition="'$(BuildNumber)' == ''">local</BuildNumber>
    <BuildCommit Condition="'$(BuildCommit)' == ''">$(SourceRevisionId)</BuildCommit>
    <Authors>Roger Bergling</Authors>
    <Company>Roger Bergling</Company>
    <Description>Multiuser web application for TimeReport.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RogerBergling/TimeReport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>TimeReport.Web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildNumber" Value="$(BuildNumber)" />
    <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeReport.Core\TimeReport.Core.csproj" />
  </ItemGroup>
</Project>
