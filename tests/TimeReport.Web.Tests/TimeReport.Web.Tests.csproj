  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TimeReport.Web\TimeReport.Web.csproj" />
  </ItemGroup>
</Project>
