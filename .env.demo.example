# Copy this file to .env.demo and adjust it for the public demo.
#
# This deployment has NO real data. The guest password and TOTP secret are
# printed on the sign-in page. The database lives on tmpfs and is wiped when
# the process restarts every TIMEREPORT_DEMO_RESET_HOURS hours.

TIMEREPORT_DEMO_HTTP_BIND=127.0.0.1
TIMEREPORT_DEMO_HTTP_PORT=8081

# Public hostname of the demo, e.g. demo.example.com. Do not use * in production.
TIMEREPORT_DEMO_ALLOWED_HOSTS=demo.example.com

# Trusted reverse proxy source CIDR as seen inside the container.
TIMEREPORT_TRUSTED_PROXIES=172.16.0.0/12

# Reset interval. The container process exits and Docker restarts it; tmpfs
# data is lost and the fake dataset is seeded again.
TIMEREPORT_DEMO_RESET_HOURS=2

TZ=UTC
